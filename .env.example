# Copia aquest fitxer a .env i omple els valors. Mai pugis el .env al repositori.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # només servidor (api, worker)
DATABASE_URL=                    # connexió Postgres per a migracions i worker

# API
API_PORT=3000
API_PUBLIC_URL=
MOBILICAT_API_KEY=               # clau per al servei d'esdeveniments

# Serveis externs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
APROP_ROUTES_BASE_URL=
APROP_ROUTES_API_KEY=

# App mòbil (Expo exposa les variables EXPO_PUBLIC_*)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
