# Copia aquest fitxer a .env (a l'arrel) i omple els valors. Mai pugis el .env al repositori.
# El llegeixen l'API, el worker i el CLI de Supabase. Les variables de l'app van a apps/mobile/.env.example.
# D'on surt cada valor: docs/onboarding.md, secció 5.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # només servidor (api, worker)
# Session pooler (usuari postgres.<ref>): el host directe db.<ref>.supabase.co només té IPv6.
DATABASE_URL=                    # connexió Postgres per a migracions i worker

# API
API_PORT=3000                    # services/api; es valida a l'arrencada (src/config/env.ts)
API_PUBLIC_URL=
APROP_API_KEY=                   # clau que fa servir Aprop per consumir el servei d'esdeveniments

# Serveis externs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
MOBILICAT_ROUTES_BASE_URL=
MOBILICAT_ROUTES_API_KEY=
