# Copia aquest fitxer a apps/mobile/.env. Expo només llegeix aquest fitxer, no el .env de l'arrel.
# Tot el que comença per EXPO_PUBLIC_ acaba dins l'app: cap secret aquí (res de service_role).

# Supabase: valors públics (Project Settings → Data API i API Keys → anon).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# API. Si no la poses, l'app fa servir http://localhost:3000/api/v1 (simulador d'iOS).
# No la deixis buida: o amb valor, o sense la línia.
#   Mòbil amb Expo Go:   http://<IP del teu ordinador>:3000/api/v1
#   Emulador d'Android:  http://10.0.2.2:3000/api/v1
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api/v1
